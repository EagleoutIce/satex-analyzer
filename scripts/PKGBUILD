# Maintainer: EagleoutIce <florian.sihler@uni-ulm.de>
 
pkgname=satex-bin
_pkgname=satex
pkgver=0.1.0
pkgrel=1
pkgdesc="Static analysis for (La)TeX and friends"
arch=('x86_64')
url="https://github.com/EagleoutIce/satex-analyzer"
license=('MIT')
depends=('glibc' 'gcc-libs')
provides=('satex')
conflicts=('satex')

options=('!debug')

_binary=satex
_source=${_pkgname}-${pkgver}-${CARCH}-unknown-linux-gnu

source=("${url}/releases/download/v${pkgver}/${_source}.tar.gz")
sha256sums=('23fcc33e8d12d1274236d0a9712ae492835dccd445861e24f728d5b6bbaabbcf')

package() {
  install -d "${pkgdir}/usr/bin"
  install -Dm755 "${_source}/${_binary}" "${pkgdir}/opt/${_pkgname}/${_binary}"
  ln -s "/opt/${_pkgname}/${_binary}" "${pkgdir}/usr/bin/${_binary}"

  install -Dm644 "${_source}/LICENSE" "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"
}
