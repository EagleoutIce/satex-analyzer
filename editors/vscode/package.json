{
  "name": "satex",
  "displayName": "satex",
  "description": "LaTeX/TeX static analysis and language server, powered by satex.",
  "version": "0.1.0",
  "publisher": "TODO-publisher-id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EagleoutIce/satex-analyzer.git",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages"
  ],
  "keywords": [
    "latex",
    "tex",
    "lint",
    "static analysis",
    "language server"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onLanguage:bibtex"
  ],
  "contributes": {
    "configuration": {
      "title": "satex",
      "properties": {
        "satex.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the `satex` binary. Empty: use the bundled binary, else `satex` on the `PATH`."
        },
        "satex.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace the communication between VS Code and the satex language server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc --noEmit -p . && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --minify --sourcemap --outfile=out/extension.js",
    "lint": "eslint src",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.0.0",
    "eslint": "^9.0.0",
    "ovsx": "^0.10.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vscode-languageclient": "^9.0.1",
    "esbuild": "^0.25.0"
  }
}
