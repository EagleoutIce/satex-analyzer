diff -ru lua-5.3.6.orig/lobject.h lua-5.3.6/lobject.h
--- lua-5.3.6.orig/lobject.h
+++ lua-5.3.6/lobject.h
@@ -180,6 +180,15 @@
 
 #define l_isfalse(o)	(ttisnil(o) || (ttisboolean(o) && bvalue(o) == 0))
 
+/* satex: the unknown value is the light userdata pointing at
+** 'satex_unknown_tag'.  Testing it, comparing it, using it as a key or
+** asking its type raises "satex: unknown" (see satex's lua_run.rs). */
+extern char satex_unknown_tag;
+#define satex_isunknown(o) \
+  (ttislightuserdata(o) && pvalue(o) == (void *)&satex_unknown_tag)
+LUAI_FUNC l_noret satex_unknown (struct lua_State *L);
+#define l_isfalseL(L,o)	(satex_isunknown(o) ? (satex_unknown(L), 0) : l_isfalse(o))
+
 
 #define iscollectable(o)	(rttype(o) & BIT_ISCOLLECTABLE)
 
